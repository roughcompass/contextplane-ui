# Server-side Vite development configuration. These names do not use the VITE_
# prefix, so the local client secret is never embedded in the browser bundle.
# On a loopback Vite origin, the dashboard automatically mints the seeded dev
# session through the server. A deployment host's runtime token provider always
# takes precedence, and non-loopback or production origins never use this flow.
CONTEXTPLANE_API_ORIGIN=http://localhost:8000
CONTEXTPLANE_DEV_IDP_ORIGIN=http://localhost:8090
CONTEXTPLANE_DEV_CLIENT_ID=registry-dev
CONTEXTPLANE_DEV_CLIENT_SECRET=dev-secret